# Copy to .env. Compose uses these variables. Never use demo credentials for real data.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DB_PASSWORD=replace-with-a-different-random-password
DATABASE_URL=postgres://atlas_app:replace-with-a-different-random-password@localhost:55441/dashboard
TEST_DATABASE_URL=postgres://dashboard:replace-with-a-long-random-password@localhost:55441/dashboard_test
PUBLIC_ORIGIN=http://localhost:5173
PORT=4100
NODE_ENV=development
TRUST_PROXY=false
# Required in production. Shared only by the private edge gateway and API.
ORIGIN_SECRET=replace-with-another-long-random-value
# Deliberately PUBLIC demo accounts; no access to real data or infrastructure.
DEMO_ADMIN_PASSWORD=DemoAdmin2026!
DEMO_USER_PASSWORD=DemoViewer2026!
RATE_LIMIT_ENABLED=true
